{
  "name": "@kiwi-tcms-ai/kiwi-tcms-client",
  "version": "0.3.0",
  "description": "Reusable TypeScript client for the Kiwi TCMS JSON-RPC API",
  "license": "MIT",
  "author": "Belov <belov.u30gt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belovdm/kiwi-tcms-client.git"
  },
  "bugs": {
    "url": "https://github.com/belovdm/kiwi-tcms-client/issues"
  },
  "homepage": "https://github.com/belovdm/kiwi-tcms-client#readme",
  "keywords": [
    "kiwi-tcms",
    "tcms",
    "json-rpc",
    "test-management",
    "client"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "default": "./dist/attachments.js"
    },
    "./builds": {
      "types": "./dist/builds.d.ts",
      "default": "./dist/builds.js"
    },
    "./case-statuses": {
      "types": "./dist/case-statuses.d.ts",
      "default": "./dist/case-statuses.js"
    },
    "./cases": {
      "types": "./dist/cases.d.ts",
      "default": "./dist/cases.js"
    },
    "./categories": {
      "types": "./dist/categories.d.ts",
      "default": "./dist/categories.js"
    },
    "./classifications": {
      "types": "./dist/classifications.d.ts",
      "default": "./dist/classifications.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./execution-statuses": {
      "types": "./dist/execution-statuses.d.ts",
      "default": "./dist/execution-statuses.js"
    },
    "./executions": {
      "types": "./dist/executions.d.ts",
      "default": "./dist/executions.js"
    },
    "./plan-types": {
      "types": "./dist/plan-types.d.ts",
      "default": "./dist/plan-types.js"
    },
    "./plans": {
      "types": "./dist/plans.d.ts",
      "default": "./dist/plans.js"
    },
    "./priorities": {
      "types": "./dist/priorities.d.ts",
      "default": "./dist/priorities.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "default": "./dist/projects.js"
    },
    "./runs": {
      "types": "./dist/runs.d.ts",
      "default": "./dist/runs.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "default": "./dist/tags.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "default": "./dist/users.js"
    },
    "./versions": {
      "types": "./dist/versions.d.ts",
      "default": "./dist/versions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "msw": "^2.3.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.5"
  }
}
